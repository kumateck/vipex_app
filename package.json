{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "dev:desktop": "bun run --cwd apps/desktop start",
    "dev:backend": "bun --hot backend/src/index.ts",
    "dev:fullstack": "concurrently \"bun run dev:web\" \"bun run dev:backend\"",
    "dev": "concurrently \"bun run dev:web\" \"bun run dev:backend\" \"bun run dev:desktop\"",
    "mobile:start": "bun run --cwd apps/mobile start",
    "mobile:android": "bun run --cwd apps/mobile android",
    "mobile:ios": "bun run --cwd apps/mobile ios",
    "build:web": "bun run --cwd apps/web build",
    "start": "NODE_ENV=production bun src/index.tsx",
    "dev:legacy": "bun run routes:generate && bun --hot src/index.tsx",
    "dev:watch": "bun run routes:watch & bun --hot src/index.tsx",
    "build": "bun run routes:generate && bun run build.ts",
    "routes:generate": "bun run scripts/generate-routes.ts",
    "routes:watch": "bun run scripts/generate-routes.ts --watch",
    "db:push": "echo \"db:push is disabled for this project. Use 'bun run migrate' (or 'pnpm migrate') to apply vetted SQL migrations.\" && exit 1",
    "db:push:unsafe": "drizzle-kit push",
    "generate": "bun run scripts/generate_single_migration.ts",
    "migrate": "bun run scripts/migrate.ts",
    "migrate:audit": "bun run scripts/add-audit.ts",
    "apply:triggers": "bun run scripts/apply_triggers.ts",
    "enable:pgcrypto": "bun run scripts/enable_pgcrypto.ts",
    "seed:init": "bun run scripts/seed_initial.ts",
    "seed:bootstrap": "bun run seed:init",
    "seed:accounting": "bun run scripts/seed_accounting.ts",
    "seed:sessions": "bun run scripts/seed_session_types.ts",
    "seed:users": "bun run scripts/seed_demo_user.ts",
    "seed:all": "bun run seed:init && bun run seed:accounting && bun run seed:sessions && bun run seed:users",
    "seed:desmond": "bun run scripts/seed_superadmin.ts",
    "prepare": "husky",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "test": "bun test",
    "test:server": "bun test tests/server",
    "test:e2e": "bun test tests/server/geolocation.api.e2e.spec.ts",
    "test:watch": "bun test --watch",
    "test:ci": "bun test --bail --timeout=30000",
    "test:prepush": "bun test tests/health.spec.ts tests/server tests/utils --bail --timeout=30000",
    "uuid:convert": "bun run scripts/convert_uuid_to_cuid.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.10.1",
    "@sentry/bun": "^10.19.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.13",
    "@types/nodemailer": "^6.4.20",
    "bun-plugin-tailwind": "^0.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "elysia": "^1.4.11",
    "framer-motion": "^12.23.26",
    "geist": "^1.7.0",
    "generouted": "^1.20.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19",
    "react-hook-form": "^7.66.0",
    "react-minimal-signature": "^0.1.1",
    "react-qrcode-logo": "^4.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.11.0",
    "react-to-print": "^3.3.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@generouted/react-router": "^1.20.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "bun-types": "^1.3.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bunx --bun eslint --fix",
      "bunx --bun prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "bunx --bun prettier --write"
    ]
  }
}
