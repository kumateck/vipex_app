{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "start": "NODE_ENV=production bun src/index.tsx",
    "build": "bun run build.ts",
    "generate": "drizzle-kit generate ",
    "migrate": "bun run scripts/migrate.ts",
    "apply:triggers": "bun run scripts/apply_triggers.ts",
    "enable:pgcrypto": "bun run scripts/enable_pgcrypto.ts",
    "seed:init": "bun run scripts/seed_initial.ts",
    "seed:sessions": "bun run scripts/seed_session_types.ts",
    "prepare": "husky",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ci": "bun test --bail --timeout=30000"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/bun": "^10.19.0",
    "@types/nodemailer": "^6.4.20",
    "bun-plugin-tailwind": "^0.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "elysia": "^1.4.11",
    "jose": "^6.1.0",
    "lucide-react": "^0.525.0",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/bun": "latest",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "bun-types": "^1.3.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bunx --bun eslint --fix",
      "bunx --bun prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "bunx --bun prettier --write"
    ]
  }
}
