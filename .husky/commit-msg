#!/usr/bin/env sh
MESSAGE_FILE="$1"

# Try commitlint first (Node, then Bun). If dependency mismatch breaks it,
# fallback to a conventional-commit regex so valid commits are not blocked.
if command -v node >/dev/null 2>&1; then
  if node ./node_modules/@commitlint/cli/cli.js --edit "$MESSAGE_FILE" >/dev/null 2>&1; then
    exit 0
  fi
fi

if command -v bunx >/dev/null 2>&1; then
  if bunx commitlint --edit "$MESSAGE_FILE" >/dev/null 2>&1; then
    exit 0
  fi
fi

FIRST_LINE="$(head -n 1 "$MESSAGE_FILE")"

case "$FIRST_LINE" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

if echo "$FIRST_LINE" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?(!)?: .+'; then
  exit 0
fi

echo "commit message validation failed:"
echo "  $FIRST_LINE"
echo "expected format: type(scope): subject"
echo "allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
exit 1
