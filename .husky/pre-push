#!/usr/bin/env sh
set -e

export PATH="$HOME/.bun/bin:$PATH"

if [ "$STRICT_PRE_PUSH" = "1" ]; then
  echo "Running strict pre-push checks (typecheck + build)..."
  bun run typecheck
  bun run build
  exit 0
fi

echo "Running non-blocking pre-push checks (set STRICT_PRE_PUSH=1 to enforce)..."
if ! bun run typecheck; then
  echo "warning: typecheck failed, push is allowed in non-strict mode"
fi

if ! bun run build; then
  echo "warning: build failed, push is allowed in non-strict mode"
fi
